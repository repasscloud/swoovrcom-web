# Copy this file to .env and replace the placeholders privately.
# .env and .env.* are ignored; .env.example is safe to commit.
# This file does not upload secrets to Cloudflare.

# Use the restricted database role, not postgres. URL-encode its password.
# Do not add sslmode parameters; the driver validates TLS certificates.
DATABASE_URL="postgresql://swoovr_signup.nnblsvjloftjotnyafcp:ENCODED_ROLE_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# Generate once with: openssl rand -hex 32
# Keep stable and backed up. Use the existing production value if already set.
WAITLIST_DEDUPE_KEY="REPLACE_WITH_YOUR_STABLE_RANDOM_KEY"

# WAITLIST_PUBLIC_KEY already comes from wrangler.jsonc.
# WAITLIST_RATE_LIMIT is a binding in wrangler.jsonc, not an env variable.
# Never put the RSA private key in this file.
# NODE_VERSION=22.22.0 belongs in Cloudflare build settings.

# For local Worker testing, use .dev.vars (see .dev.vars.example).
# An existing .dev.vars takes precedence: Wrangler will not load .env.
# LOCAL_DEVELOPMENT=true is local-only; never upload it to production.
