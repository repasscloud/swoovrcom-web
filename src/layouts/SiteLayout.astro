---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Splash from '../components/Splash.astro';
import Motion from '../components/Motion.astro';
import '../styles/global.css';
import geometry from '../../branding/source/geometry.json';
const { title, description, eyebrow, heading, intro, draft = false, theme = '' } = Astro.props;
const referralIcon = 'data:image/svg+xml,' + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 432 432"><rect width="432" height="432" rx="80" fill="#1e3857"/><path fill="#d0b786" fill-rule="evenodd" transform="translate(24 54)" d="${geometry.bird.path}"/></svg>`);
const canonical = new URL(Astro.url.pathname, 'https://swoovr.com').href;
const ogImage = 'https://swoovr.com/brand/og-image.png';
---
<!doctype html>
<html lang="en-AU"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><script is:inline>document.documentElement.classList.add('js')</script><meta name="theme-color" content={theme === 'referral' ? '#1e3857' : '#ffffff'} /><title>{title} · Swoovr</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /><meta property="og:title" content={`${title} · Swoovr`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:site_name" content="Swoovr" /><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Swoovr logo" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:site" content="@swoovrapp" /><meta name="twitter:image" content={ogImage} /><meta name="twitter:image:alt" content="Swoovr logo" /><link rel="sitemap" type="application/xml" href="/sitemap-index.xml" /><link rel="icon" type={theme === 'referral' ? 'image/svg+xml' : 'image/png'} href={theme === 'referral' ? referralIcon : '/favicon.png'} />{theme !== 'referral' && <><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /></>}{draft && <meta name="robots" content="noindex, nofollow" />}</head>
<body class:list={[theme && `theme-${theme}`]}><Splash /><Header /><main id="main-content" class="page-main">{heading && <section class="page-hero"><p class="eyebrow">{eyebrow}</p><h1>{heading}</h1><p class="page-intro">{intro}</p></section>}<slot /></main><Footer /><Motion /></body></html>
