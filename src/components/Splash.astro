---
// Swoovr first-load splash: the bird draws itself, fills, "swoovr" rises letter by letter,
// a hairline fills, then the panel wipes up to reveal the page. Ported from the app sign-in
// splash (swoovr-marketing/video/src/SignInDemo.tsx), sped up for the web (about 2.2s).
//
// Usage: <Splash /> as the FIRST child of <body>. It includes its own inline <head>-safe script.
// Shown once per browser session; skipped for prefers-reduced-motion; click or any key skips it.
// No JS = no splash (the overlay is display:none unless the script adds .has-splash), so the page
// can never get stuck behind it.
//
// Colours come from --splash-bg / --splash-fg. Defaults are ink on white-text; a theme can
// override them (swoovr.com /referral sets navy #1E3857 and gold #D0B786).
const BIRD = "M139 0C153.755264 7.892353 168.569412 15.313709 182.947464 22.516602C252.37085 57.295238 311.627411 86.980667 305 140C304.202057 150.107193 301.06955 159.719162 296.279846 168.835938C297.106506 168.971268 298.010498 169.491089 298.900879 170.167953C327.374664 144.083389 345.228699 148.062378 367 154C373 156 378 156 384 156C355 164 350 185 339 207C310 270 226 282 97 324C153.7 289.85 197.8 257.1 233.4 227.7C236.604 225.054 238.45 222.35 239.85 218.65C260.85 163.15 218.0 80.86 139 0ZM77 137C120 159 205 163 226 192C259.219879 239.585236 132.02446 263.793365 32.588951 282.71817C21.274101 284.871643 10.3187 286.956696 0 289C79 260 166 226 180 207C188.996353 193.205597 164.180161 181.929153 134.46019 168.424454C114.626785 159.41217 92.609497 149.407547 77 137Z";
const letters = 'swoovr'.split('');
---
<script is:inline>
  (function(){
    try {
      if (sessionStorage.getItem('swoovr-splash')) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      sessionStorage.setItem('swoovr-splash', '1');
      document.documentElement.classList.add('has-splash');
    } catch (e) {}
  })();
</script>
<div class="splash" data-splash aria-hidden="true">
  <svg class="splash-bird" viewBox="140 30 420 356">
    <path d={BIRD} transform="translate(145 35.03125) scale(1.067708)" fill-rule="evenodd" pathLength="1" />
  </svg>
  <div class="splash-word">{letters.map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</div>
  <div class="splash-line"><span></span></div>
  <p class="splash-tag">Dating · Friendship · Activities</p>
</div>
<script is:inline>
  (function(){
    var root = document.documentElement;
    var el = document.querySelector('[data-splash]');
    if (!el || !root.classList.contains('has-splash')) { if (el) el.remove(); return; }
    var done = function(){ root.classList.remove('has-splash'); el.remove(); };
    el.addEventListener('animationend', function(e){ if (e.animationName === 'splash-wipe') done(); });
    el.addEventListener('click', done);
    window.addEventListener('keydown', done, { once: true });
    setTimeout(done, 4000); // failsafe
  })();
</script>
<style is:global>
  .splash{display:none}
  .has-splash .splash{
    --out:cubic-bezier(.2,.8,.2,1);--inout:cubic-bezier(.76,0,.24,1);
    position:fixed;inset:0;z-index:1000;display:flex;flex-direction:column;align-items:center;justify-content:center;
    background:var(--splash-bg,#0A0A0A);color:var(--splash-fg,#FAFAFA);cursor:pointer;
    font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;
    clip-path:inset(0 0 -60px 0 round 0 0 48px 48px);
    animation:splash-wipe .55s var(--inout) 1.65s forwards;
  }
  .has-splash{overflow:hidden}
  .splash-bird{width:clamp(96px,12vw,132px);overflow:visible}
  .splash-bird path{
    fill:currentColor;fill-opacity:0;stroke:currentColor;stroke-width:3;stroke-dasharray:1;stroke-dashoffset:1;
    animation:splash-draw .8s var(--inout) forwards,splash-fill .3s var(--out) .74s forwards;
  }
  .splash-word{display:flex;overflow:hidden;margin-top:22px;padding-left:.3em;font-size:30px;font-weight:700;letter-spacing:.3em}
  .splash-word span{display:inline-block;transform:translateY(110%);animation:splash-rise .42s var(--out) calc(.72s + var(--i) * .03s) forwards}
  .splash-line{margin-top:34px;width:120px;height:1px;background:color-mix(in srgb,currentColor 18%,transparent)}
  .splash-line span{display:block;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;animation:splash-grow .85s var(--inout) .54s forwards}
  .splash-tag{position:absolute;bottom:52px;margin:0;font-size:12px;letter-spacing:.03em;opacity:0;color:color-mix(in srgb,currentColor 55%,transparent);animation:splash-fade .36s var(--out) .9s forwards}
  @keyframes splash-draw{to{stroke-dashoffset:0}}
  @keyframes splash-fill{to{fill-opacity:1;stroke-width:0}}
  @keyframes splash-rise{to{transform:none}}
  @keyframes splash-grow{to{transform:scaleX(1)}}
  @keyframes splash-fade{to{opacity:1}}
  @keyframes splash-wipe{to{clip-path:inset(0 0 100% 0 round 0 0 48px 48px)}}
</style>
