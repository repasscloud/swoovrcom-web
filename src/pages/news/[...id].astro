---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
export async function getStaticPaths() {
 const entries = await getCollection('news', ({data}) => import.meta.env.DEV || !data.draft);
 return entries.map(entry => ({params:{id:entry.id},props:{entry}}));
}
const {entry} = Astro.props;
const {Content} = await render(entry);
---
<SiteLayout title={entry.data.title} description={entry.data.description} eyebrow={entry.data.category} heading={entry.data.title} intro={entry.data.description} draft={entry.data.draft}>
 <article class="article-body">{entry.data.draft && <p class="draft-banner">Draft preview · visible only in local Astro development. Review wording and product status before publishing.</p>}<p class="article-byline">{entry.data.author} · {entry.data.date.toLocaleDateString('en-AU',{day:'numeric',month:'long',year:'numeric',timeZone:'Australia/Adelaide'})}</p><Content /><a class="text-link" href="/news/">← News & stories</a></article>
</SiteLayout>
