{
  "openapi": "3.1.0",
  "info": {
    "title": "Swoovr website submissions API",
    "version": "3.0.0",
    "description": "Same-origin encrypted PostgreSQL newsletter signup and contact/beta enquiries. No automatic email, ownership confirmation or beta admission. Enquiry permission is separate from marketing consent."
  },
  "servers": [
    {
      "url": "https://swoovr.com"
    }
  ],
  "paths": {
    "/api/waitlist": {
      "post": {
        "operationId": "joinWaitlist",
        "summary": "Submit an email and permission for launch updates",
        "description": "Same-origin application/json only; maximum 4096 bytes. Validates adult declaration and specific marketing consent. Encrypts personal fields before PostgreSQL insert. Deduplicates email using a secret HMAC. Existing records, including suppression and first referral, remain unchanged. Generates a private random share code, not returned or emailed. A populated honeypot is silently discarded. No sensitive data enters analytics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "consent",
                  "adult"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "consent": {
                    "type": "boolean",
                    "const": true
                  },
                  "website": {
                    "type": "string",
                    "description": "Honeypot; normal clients send an empty string."
                  },
                  "adult": {
                    "type": "boolean",
                    "const": true
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 100,
                    "enum": [
                      "",
                      "Adelaide",
                      "Brisbane",
                      "Canberra",
                      "Darwin",
                      "Gold Coast",
                      "Hobart",
                      "Melbourne",
                      "Newcastle",
                      "Perth",
                      "Sunshine Coast",
                      "Sydney",
                      "Wollongong",
                      "Other"
                    ]
                  },
                  "betaInterest": {
                    "type": "boolean"
                  },
                  "referralCode": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]*$",
                    "description": "Optional; recorded only. Not checked or redeemed."
                  }
                }
              },
              "example": {
                "email": "person@example.com",
                "consent": true,
                "website": "",
                "adult": true
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Database accepted insert or existing registration, or honeypot discarded. Body {ok:true}. Does not confirm ownership or grant access."
          },
          "400": {
            "description": "Invalid JSON, email or consent. Body: {ok:false,error:string}."
          },
          "403": {
            "description": "Missing or invalid Origin."
          },
          "405": {
            "description": "Method other than POST; Allow: POST."
          },
          "413": {
            "description": "Request exceeds 4096 bytes."
          },
          "415": {
            "description": "Content-Type must be application/json."
          },
          "429": {
            "description": "Throttled; Retry-After: 60."
          },
          "502": {
            "description": "Database operation unconfirmed. Retrying is deduplicated by email."
          },
          "503": {
            "description": "Missing/invalid database or encryption configuration, or limiter unavailable."
          }
        }
      }
    },
    "/api/enquiries": {
      "post": {
        "summary": "Store an encrypted contact or beta enquiry",
        "description": "Same-origin JSON only. Max body 16384 bytes. Reply permission is required; this never adds marketing consent. Beta also requires adult=true and a device. Three submissions per IP per minute. A requestId is idempotent: a duplicate never changes the first message. A 202 means durable acceptance/existing request or silent honeypot discard, not a reply or invitation. No email is sent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requestId",
                  "kind",
                  "name",
                  "email",
                  "message",
                  "replyConsent"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Random v4 browser submission ID, preserved across retries."
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "contact",
                      "beta"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "message": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 3000
                  },
                  "replyConsent": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "topic": {
                    "type": "string",
                    "enum": [
                      "general",
                      "venue",
                      "press",
                      "feedback",
                      "privacy",
                      "support"
                    ],
                    "default": "general"
                  },
                  "organisation": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 100,
                    "enum": [
                      "",
                      "Adelaide",
                      "Brisbane",
                      "Canberra",
                      "Darwin",
                      "Gold Coast",
                      "Hobart",
                      "Melbourne",
                      "Newcastle",
                      "Perth",
                      "Sunshine Coast",
                      "Sydney",
                      "Wollongong",
                      "Other"
                    ]
                  },
                  "device": {
                    "type": "string",
                    "enum": [
                      "iOS",
                      "Android",
                      "Both",
                      "Web"
                    ]
                  },
                  "availability": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "adult": {
                    "type": "boolean"
                  },
                  "website": {
                    "type": "string",
                    "description": "Hidden honeypot; leave empty."
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "beta"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "adult",
                        "device"
                      ],
                      "properties": {
                        "adult": {
                          "const": true
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted or existing request; no personal information returned."
          },
          "400": {
            "description": "Invalid fields or missing permission."
          },
          "403": {
            "description": "Wrong or missing Origin."
          },
          "405": {
            "description": "Use POST; Allow header returned."
          },
          "413": {
            "description": "Body exceeds 16384 bytes."
          },
          "415": {
            "description": "Use application/json."
          },
          "429": {
            "description": "Rate limited; Retry-After: 60."
          },
          "502": {
            "description": "Encryption or storage not confirmed; retry with same requestId."
          },
          "503": {
            "description": "Service not configured or temporarily unavailable."
          }
        }
      }
    }
  }
}
