{
  "name": "swoovr-corporate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "photos": "node scripts/prepare-photos.mjs",
    "dev": "npm run photos && astro dev",
    "build": "npm run photos && astro build && node scripts/generate-routes.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "dev:worker": "npm run build && wrangler dev --port 8787 --local-upstream localhost:8787",
    "deploy": "./deploy.sh",
    "key:setup": "node scripts/setup-waitlist-key.mjs",
    "waitlist:decrypt": "node scripts/decrypt-waitlist.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "release": "node scripts/release.mjs",
    "dev:review": "npm run build && node scripts/local-review.mjs",
    "test:db": "node tests/migrations.integration.mjs"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "miniflare": "5.20261012.1-beta",
    "wrangler": "^4.151.1"
  }
}
