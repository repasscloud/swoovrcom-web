{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swoovr-com-web",
  "account_id": "8d7f0c4cf8b2408a145786b0996af45b",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
